{
  "name": "@sirv/core",
  "version": "0.0.0",
  "description": "Host-agnostic Sirv DAM hooks (clientId/secret auth, folders, search, type filters), asset types and Zod schemas. Contains ZERO host-specific (Sanity/Strapi/etc) code.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./assets": {
      "types": "./src/assets.ts",
      "default": "./src/assets.ts"
    },
    "./search-query": {
      "types": "./src/hooks/search-query.ts",
      "default": "./src/hooks/search-query.ts"
    },
    "./types": {
      "types": "./src/types.ts",
      "default": "./src/types.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@sirv/sirv-client": "workspace:*",
    "@sirv/url-builder": "workspace:*",
    "zod": "^3.23.8"
  },
  "peerDependencies": {
    "react": "^18.0.0"
  }
}
